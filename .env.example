# Lyra environment template — copy to .env and fill in.
# Every entry below was discovered from real usages in this repo; nothing invented.
# System-provided vars (HOME, USER, UID, XDG_RUNTIME_DIR) are intentionally omitted.

# --- Torznab provider (crates/lyra-ffi/src/lib.rs) ---
# Required by the FFI test helper: `std::env::var("LYRA_TORZNAB_URL").expect(...)`.
# Example: LYRA_TORZNAB_URL=https://indexer.example.com/torznab
LYRA_TORZNAB_URL=
# Optional API key for the same helper (`unwrap_or_default`, empty = no key).
LYRA_TORZNAB_KEY=

# --- Daemon socket override (crates/lyra-ipc/src/paths.rs, docs/research/agent-native-design.md) ---
# Explicit socket path; overrides well-known paths. Used by tests/weird setups.
# Example: LYRA_SOCKET=/tmp/lyra-test.sock
LYRA_SOCKET=

# --- Logging (crates/lyra-ffi/src/lib.rs: tracing_subscriber::EnvFilter::try_from_default_env()) ---
# Standard tracing directive string. Example: RUST_LOG=lyra_engine=debug,info
RUST_LOG=

# --- Embedding weights (crates/lyra-map/src/grid.rs, crates/lyra-map/src/bin/lyra-mapgen.rs) ---
# Env-gated: real-weight tests only run with one of these pointing at a models dir.
# (--models-dir CLI flag wins over both when present.)
# Example: LYRA_TEST_MODELS=/path/to/models
LYRA_TEST_MODELS=
# Example: LYRA_MODELS_DIR=/path/to/models
LYRA_MODELS_DIR=

# --- Live SSH smoke test (crates/lyra-fs/src/sftp.rs) ---
# Skipped unless set. Format is strict: user@host:/path/to/file
# Example: LYRA_TEST_SSH=user@host:/path/to/file
LYRA_TEST_SSH=

# --- SwiftUI debug hooks (app/Sources/LyraApp/AppDelegate.swift, ContentView.swift) ---
# Headless playback hook for VM/CLI QA. Value is a path to a .wav file.
# Example: LYRA_AUTOPLAY=/path/to/file.wav
LYRA_AUTOPLAY=
# Debug pane lane: visuals|library|discover|eq|remote|mini
# Example: LYRA_DEBUG_PANE=mini
LYRA_DEBUG_PANE=
