<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The core delta vs BitMuse: we ARE sandboxed. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- user picks music folders once; we keep access via bookmarks -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- outbound: last.fm/musicbrainz/lrclib/coverart/license/appcast -->
    <key>com.apple.security.network.client</key><true/>
    <!-- inbound: LAN remote-control listener -->
    <key>com.apple.security.network.server</key><true/>
    <!-- intentionally absent: no AppleEvents/Finder automation.
         Network volumes are reached via bookmarked mount paths, not
         "mount volume" AppleScript + Finder restarts. -->
</dict>
</plist>
